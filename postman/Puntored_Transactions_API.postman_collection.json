{
  "info": {
    "name": "Puntored Transactions API",
    "description": "Colección de requests para probar la API de recargas de Puntored",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "puntored_token",
      "value": "",
      "type": "string",
      "description": "Token Bearer de Puntored (para /api/suppliers)"
    },
    {
      "key": "supabase_jwt",
      "value": "",
      "type": "string",
      "description": "JWT de Supabase (para /api/recharges y /api/transactions)"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Obtener Token de Puntored",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('puntored_token', jsonData.token);",
                  "    console.log('Token de Puntored guardado:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth",
              "host": ["{{base_url}}"],
              "path": ["api", "auth"]
            },
            "description": "Obtiene un token Bearer para autenticación con la API de Puntored. Este token se usa para /api/suppliers."
          },
          "response": []
        },
        {
          "name": "[DEV] Generar JWT de Supabase",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('supabase_jwt', jsonData.jwt);",
                  "    console.log('JWT de Supabase guardado:', jsonData.jwt);",
                  "    console.log('Email:', jsonData.email);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/test-jwt?email=test@example.com",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "test-jwt"],
              "query": [
                {
                  "key": "email",
                  "value": "test@example.com",
                  "description": "Email del usuario para el JWT (opcional)"
                }
              ]
            },
            "description": "Genera un JWT válido de Supabase para pruebas. Solo disponible en desarrollo. Este JWT se usa para /api/recharges y /api/transactions."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Proveedores",
      "item": [
        {
          "name": "Listar Proveedores",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{puntored_token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/suppliers",
              "host": ["{{base_url}}"],
              "path": ["api", "suppliers"]
            },
            "description": "Lista todos los proveedores de recargas disponibles. Requiere token de Puntored."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Recargas",
      "item": [
        {
          "name": "Crear Recarga - Claro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text",
                "description": "JWT de Supabase (NO token de Puntored)"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"3001234567\",\n  \"amount\": 10000,\n  \"supplierId\": \"8753\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Crea una recarga de 10,000 pesos para Claro. Requiere JWT de Supabase (no token de Puntored)."
          },
          "response": []
        },
        {
          "name": "Crear Recarga - Movistar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"3101234567\",\n  \"amount\": 20000,\n  \"supplierId\": \"9773\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Crea una recarga de 20,000 pesos para Movistar. Requiere JWT de Supabase."
          },
          "response": []
        },
        {
          "name": "Crear Recarga - Tigo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"3501234567\",\n  \"amount\": 15000,\n  \"supplierId\": \"3398\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Crea una recarga de 15,000 pesos para Tigo. Requiere JWT de Supabase."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Transacciones",
      "item": [
        {
          "name": "Listar Transacciones del Usuario",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text",
                "description": "JWT de Supabase"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transactions",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions"]
            },
            "description": "Obtiene el historial de transacciones del usuario autenticado. Requiere JWT de Supabase."
          },
          "response": []
        },
        {
          "name": "Obtener Transacción por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transactions/1",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions", "1"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Obtiene los detalles de una transacción específica por ID. Solo muestra transacciones del usuario autenticado. Requiere JWT de Supabase."
          },
          "response": []
        },
        {
          "name": "Transacciones por Teléfono",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/transactions/phone/3001234567",
              "host": ["{{base_url}}"],
              "path": ["api", "transactions", "phone", "3001234567"],
              "variable": [
                {
                  "key": "phoneNumber",
                  "value": "3001234567"
                }
              ]
            },
            "description": "Obtiene todas las transacciones de un número de teléfono específico, solo del usuario autenticado. Requiere JWT de Supabase."
          },
          "response": []
        }
      ]
    },
    {
      "name": "5. Validaciones",
      "item": [
        {
          "name": "Error - Teléfono Inválido (no inicia con 3)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"2001234567\",\n  \"amount\": 10000,\n  \"supplierId\": \"8753\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Debe retornar error 400 - teléfono no inicia con 3"
          },
          "response": []
        },
        {
          "name": "Error - Teléfono con Longitud Incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"300123456\",\n  \"amount\": 10000,\n  \"supplierId\": \"8753\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Debe retornar error 400 - teléfono debe tener exactamente 10 dígitos"
          },
          "response": []
        },
        {
          "name": "Error - Monto Menor al Mínimo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"3001234567\",\n  \"amount\": 500,\n  \"supplierId\": \"8753\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Debe retornar error 400 - monto menor a 1000"
          },
          "response": []
        },
        {
          "name": "Error - Monto Mayor al Máximo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supabase_jwt}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"3001234567\",\n  \"amount\": 150000,\n  \"supplierId\": \"8753\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Debe retornar error 400 - monto mayor a 100000"
          },
          "response": []
        },
        {
          "name": "Error - Sin JWT (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"3001234567\",\n  \"amount\": 10000,\n  \"supplierId\": \"8753\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/recharges",
              "host": ["{{base_url}}"],
              "path": ["api", "recharges"]
            },
            "description": "Debe retornar error 401 - falta token de autenticación"
          },
          "response": []
        }
      ]
    }
  ]
}

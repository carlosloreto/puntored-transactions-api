# Variables de Entorno para PRODUCCIÓN
# Copiar este archivo a .env y configurar con valores reales
# NUNCA commitear el archivo .env con credenciales reales

# ===========================================
# BASE DE DATOS (Supabase PostgreSQL)
# ===========================================
DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.tu-proyecto-id
DB_PASSWORD=tu-password-seguro

# Configuración opcional del pool de conexiones
DB_POOL_SIZE=20
DB_MIN_IDLE=10

# ===========================================
# API DE PUNTORED
# ===========================================
PUNTORED_BASE_URL=https://us-central1-puntored-dev.cloudfunctions.net/technicalTest-developer/api
PUNTORED_API_KEY=tu-api-key-de-puntored
PUNTORED_USER=tu-usuario
PUNTORED_PASSWORD=tu-password

# ===========================================
# CORS - Orígenes permitidos
# ===========================================
# Separar múltiples dominios con comas (sin espacios)
# Ejemplo: https://miapp.com,https://www.miapp.com
ALLOWED_ORIGINS=https://tu-frontend-produccion.com

# ===========================================
# SUPABASE JWT
# ===========================================
# JWT Secret de Supabase para validar tokens
# Obtener de: Supabase Dashboard > Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=tu-supabase-jwt-secret

# JWT Issuer de Supabase (URL del proyecto)
# Formato: https://{PROJECT_REF}.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=https://tu-proyecto.supabase.co/auth/v1

# ===========================================
# NOTAS
# ===========================================
# 1. En desarrollo local, usar el perfil 'dev' que no requiere estas variables
# 2. En producción, configurar estas variables en el sistema/contenedor
# 3. Para Railway/Render/Heroku: configurar en el panel de variables de entorno
# 4. Para Docker: pasar con -e o usar archivo .env
# 5. Para AWS/GCP: usar AWS Secrets Manager / GCP Secret Manager

